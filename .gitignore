# Source tools + user's own tools — kept out of version control
Tools/

# Any stray source zips (e.g. Shadowbroker-main.zip still at root)
*.zip


# Case files — argus/store.py writes here when ARGUS_HOME points inside the repo
.argus/

# Secrets. Argus's own secret_scan module flags these; don't ship one.
.env

# Packaging build artifacts (pip install . / build)
build/
dist/
*.egg-info/

# macOS + Python noise
.DS_Store
*.jpeg
*.jpg
*.png
__pycache__/
*.pyc
.venv/

*.txt